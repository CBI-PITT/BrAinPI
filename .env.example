# Host directory mounted read-only at /data inside the container.
BRAINPI_DATA_DIR=/absolute/path/to/brainpi/data

# Generate a different value for every deployment with:
# python3 -c "import secrets; print(secrets.token_hex(32))"
BRAINPI_SECRET_KEY=replace-with-a-long-random-secret

# Browser-reachable URL and host port.
BRAINPI_PUBLIC_URL=http://localhost:5001/
BRAINPI_PORT=5001

# Host port for the separately supervised Neuroglancer frontend. Its
# browser-facing URL is configured in docker/settings.ini.
BRAINPI_NG_PORT=9999

# UID/GID assigned to the non-root user inside the image.
BRAINPI_UID=10001
BRAINPI_GID=10001

# Optional alternative configuration paths on the host. When these variables
# are not set, Compose uses docker/settings.ini and docker/groups.ini.
# BRAINPI_SETTINGS_FILE=./docker/settings.ini
# BRAINPI_GROUPS_FILE=./docker/groups.ini
