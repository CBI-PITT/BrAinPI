# Required: existing absolute host directory mounted read-only at /data inside
# the BrAinPI container. Dataset aliases in docker/settings.ini must therefore
# use container paths below /data, not host paths.
BRAINPI_DATA_DIR=/absolute/path/to/brainpi/data

# Required: shared secret for Flask sessions and signed URLs. Generate a
# different value for every deployment with:
# python3 -c "import secrets; print(secrets.token_hex(32))"
BRAINPI_SECRET_KEY=replace-with-a-long-random-secret

# Optional: host port published for BrAinPI. The container always listens on
# port 5001. The Compose default is 5001. If this changes, also set
# BRAINPI_PUBLIC_URL to the matching browser-visible port; this variable does
# not change [app] url by itself.
# BRAINPI_PORT=5001

# Optional: complete browser-reachable BrAinPI URL. This overrides [app] url in
# docker/settings.ini. Keep it consistent with BRAINPI_PORT. The Compose default
# is http://localhost:5001/. Use the real hostname and HTTPS URL behind a proxy.
# BRAINPI_PUBLIC_URL=http://localhost:5001/

# Optional: host port published for the separately supervised Neuroglancer
# frontend. The container always listens on port 9999. The Compose default is
# 9999. This does not change [neuroglancer] url in docker/settings.ini; that
# option must contain the corresponding browser-reachable host port. Do not
# change [neuroglancer] local_port for a host-only port remapping.
# BRAINPI_NG_PORT=9999

# Optional: Compose project name. Set this when running multiple deployments so
# their containers, networks, cache volume, and pyramid volume remain separate.
# The default is derived from the repository directory name.
# COMPOSE_PROJECT_NAME=brainpi

# Optional: UID/GID assigned to the non-root user inside the image. Match these
# to host ownership only when bind-mounted writable paths require it. Compose
# defaults both values to 10001.
# BRAINPI_UID=10001
# BRAINPI_GID=10001

# Optional alternative configuration paths on the host. When these variables
# are not set, Compose uses docker/settings.ini and docker/groups.ini.
# BRAINPI_SETTINGS_FILE=./docker/settings.ini
# BRAINPI_GROUPS_FILE=./docker/groups.ini
